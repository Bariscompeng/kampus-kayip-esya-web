@using System.Globalization
@using KampusKayipEsya.Web.Models.Enums
@using KampusKayipEsya.Web.ViewModels.Gorevli
@model ApprovalQueueViewModel
@{
    ViewData["Title"] = "Onay Kuyruğu";
    var tr = new CultureInfo("tr-TR");
    var sayfa = Model.Bekleyenler.Page;
}

<h1 class="h3 mb-0">Onay kuyruğu</h1>
<p class="admin-lede" role="status">
    @(Model.Bekleyenler.TotalCount == 0 ? "Onay bekleyen ilan yok." : $"{Model.Bekleyenler.TotalCount} ilan onay bekliyor · en eskisi en üstte")
</p>

@if (Model.Bekleyenler.Items.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-inbox" aria-hidden="true"></i>
        <strong>@(sayfa > 1 ? "Bu sayfada ilan kalmadı" : "Kuyruk boş")</strong>
        <span>@(sayfa > 1 ? "Önceki sayfalardaki ilanlar işlenmiş olabilir." : "Yeni ilanlar açıldıkça burada görünecek.")</span>
        @if (sayfa > 1)
        {
            <a class="btn btn-outline-primary" asp-action="Index">İlk sayfaya dön</a>
        }
    </div>
}
else
{
    @foreach (var ilan in Model.Bekleyenler.Items)
    {
        var fotograflar = ilan.Photos.OrderBy(p => p.Order).ToList();
        <article class="queue-card" aria-labelledby="ilan-@ilan.Id">
            <div class="queue-card-head">
                <span class="@ilan.Type.TagClass()">@ilan.Type.ToTurkish()</span>
                <span class="chip"><i class="bi @(ilan.Category.Icon ?? "bi-tag")" aria-hidden="true"></i>@ilan.Category.Name</span>
                <span class="wait-time"><i class="bi bi-hourglass-split" aria-hidden="true"></i>@ApprovalQueueViewModel.BeklemeSuresi(ilan.CreatedAt) bekliyor</span>
            </div>
            <div class="queue-card-body">
                <div class="row g-3">
                    <div class="col-12 col-md-8">
                        <h2 class="queue-title" id="ilan-@ilan.Id">
                            <a href="/items/@ilan.Id" target="_blank" rel="noopener">@ilan.Title <i class="bi bi-box-arrow-up-right small" aria-hidden="true"></i><span class="visually-hidden"> (yeni sekmede açılır)</span></a>
                        </h2>
                        <div class="item-meta mb-2" style="white-space: normal">
                            <span class="text-nowrap"><i class="bi bi-person" aria-hidden="true"></i> @ilan.Owner.FullName</span> ·
                            <span class="text-nowrap"><i class="bi bi-geo-alt" aria-hidden="true"></i> @ilan.Location.Building@(ilan.Location.FloorOrRoom is null ? "" : ", " + ilan.Location.FloorOrRoom)</span> ·
                            <span class="text-nowrap"><i class="bi bi-calendar-event" aria-hidden="true"></i> @ilan.EventDate.ToString("d MMMM yyyy", tr)</span>
                        </div>
                        <p class="mb-2" style="white-space: pre-line">@ilan.Description</p>
                        @if (ilan.VerificationQuestion is not null)
                        {
                            <div class="small field-panel py-2">
                                <span class="fw-semibold"><i class="bi bi-shield-lock me-1" aria-hidden="true"></i>Doğrulama sorusu:</span> @ilan.VerificationQuestion
                            </div>
                        }
                    </div>
                    <div class="col-12 col-md-4">
                        @if (fotograflar.Count == 0)
                        {
                            <div class="empty-state py-3 small">
                                <i class="bi bi-image" aria-hidden="true"></i>Fotoğraf yok
                            </div>
                        }
                        else
                        {
                            <div class="queue-thumbs">
                                @foreach (var foto in fotograflar)
                                {
                                    <a href="@Url.Content("~/" + foto.Path)" target="_blank" rel="noopener">
                                        <img src="@Url.Content("~/" + foto.Path)" alt="@ilan.Title, fotoğraf @(foto.Order + 1)" width="72" height="72" loading="lazy" />
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="queue-card-foot">
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#retPenceresi"
                        data-baslik="@ilan.Title" data-adres="@Url.Action("Reject", new { id = ilan.Id, page = sayfa })">
                    <i class="bi bi-x-circle me-2" aria-hidden="true"></i>Reddet
                </button>
                <form asp-action="Approve" asp-route-id="@ilan.Id" asp-route-page="@sayfa" method="post" class="m-0">
                    <button type="submit" class="btn btn-success"><i class="bi bi-check-circle me-2" aria-hidden="true"></i>Onayla ve yayınla</button>
                </form>
            </div>
        </article>
    }

    @if (Model.SayfaSayisi > 1)
    {
        <nav aria-label="Onay kuyruğu sayfaları" class="d-flex justify-content-between align-items-center">
            <a class="btn btn-outline-secondary btn-sm @(sayfa <= 1 ? "disabled" : "")" asp-action="Index" asp-route-page="@(sayfa - 1)">
                <i class="bi bi-chevron-left" aria-hidden="true"></i> Önceki
            </a>
            <span class="small text-muted">Sayfa @sayfa / @Model.SayfaSayisi</span>
            <a class="btn btn-outline-secondary btn-sm @(sayfa >= Model.SayfaSayisi ? "disabled" : "")" asp-action="Index" asp-route-page="@(sayfa + 1)">
                Sonraki <i class="bi bi-chevron-right" aria-hidden="true"></i>
            </a>
        </nav>
    }
}

<div class="modal fade" id="retPenceresi" tabindex="-1" aria-labelledby="retBaslik" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" method="post" id="retFormu">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="retBaslik">İlanı reddet</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted mb-2" id="retIlan"></p>
                <label for="retSebep" class="form-label">Ret sebebi</label>
                <textarea class="form-control" id="retSebep" name="Reason" rows="3" required
                          minlength="@RejectItemViewModel.SebepEnAz" maxlength="@RejectItemViewModel.SebepEnFazla"
                          placeholder="Ör. Fotoğrafta kişisel bilgi görünüyor; lütfen kapatıp yeniden gönderin."></textarea>
                <div class="form-text">İlan sahibi bu sebebi görecek; ilanı düzenleyip yeniden onaya gönderebilir.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button>
                <button type="submit" class="btn btn-danger">Reddet</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("retPenceresi").addEventListener("show.bs.modal", olay => {
            const tetik = olay.relatedTarget;
            document.getElementById("retFormu").action = tetik.dataset.adres;
            document.getElementById("retIlan").textContent = "“" + tetik.dataset.baslik + "”";
            document.getElementById("retSebep").value = "";
        });
        document.getElementById("retPenceresi").addEventListener("shown.bs.modal", () => document.getElementById("retSebep").focus());
    </script>
}
