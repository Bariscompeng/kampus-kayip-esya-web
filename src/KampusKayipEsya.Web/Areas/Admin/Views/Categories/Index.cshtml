@model List<CategoryListItem>
@{
    ViewData["Title"] = "Kategoriler";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1 class="h3 mb-0"><i class="bi bi-tags me-2"></i>Kategoriler</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Yeni kategori</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Simge</th>
                        <th>Ad</th>
                        <th class="text-center">İlan sayısı</th>
                        <th class="text-end pe-3">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var kategori in Model)
                    {
                        <tr>
                            <td class="ps-3">
                                <i class="bi @(kategori.Icon ?? "bi-question-square") fs-4 text-primary"></i>
                                <code class="small ms-2 d-none d-md-inline">@kategori.Icon</code>
                            </td>
                            <td class="fw-semibold">@kategori.Name</td>
                            <td class="text-center">
                                <span class="badge @(kategori.ItemCount > 0 ? "text-bg-info" : "text-bg-light")">@kategori.ItemCount</span>
                            </td>
                            <td class="text-end pe-3 text-nowrap">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@kategori.Id">
                                    <i class="bi bi-pencil"></i><span class="d-none d-sm-inline ms-1">Düzenle</span>
                                </a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@kategori.Id">
                                    <i class="bi bi-trash"></i><span class="d-none d-sm-inline ms-1">Sil</span>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="4" class="text-center text-muted py-4">Henüz kategori yok.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
