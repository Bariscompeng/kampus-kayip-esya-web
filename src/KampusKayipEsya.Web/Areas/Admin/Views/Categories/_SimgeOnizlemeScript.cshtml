<script>
    (() => {
        const kutu = document.getElementById("Icon");
        const simge = document.getElementById("simgeOnizleme");
        if (!kutu || !simge) return;
        const guncelle = () => {
            const ad = kutu.value.trim();
            simge.className = "bi " + (/^bi-[a-z0-9-]+$/.test(ad) ? ad : "bi-question-square");
        };
        kutu.addEventListener("input", guncelle);
        guncelle();
    })();
</script>
