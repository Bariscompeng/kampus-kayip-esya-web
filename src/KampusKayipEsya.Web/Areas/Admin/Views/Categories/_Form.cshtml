@model CategoryFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
<input asp-for="Id" type="hidden" />

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" maxlength="50" />
    <span asp-validation-for="Name" class="text-danger small"></span>
</div>

<div class="mb-4">
    <label asp-for="Icon" class="form-label"></label>
    <div class="input-group">
        <span class="input-group-text"><i id="simgeOnizleme" class="bi @(Model.Icon ?? "bi-question-square")"></i></span>
        <input asp-for="Icon" class="form-control" maxlength="50" placeholder="bi-phone" />
    </div>
    <div class="form-text">
        Ad listesi: <a href="https://icons.getbootstrap.com/" target="_blank" rel="noopener">icons.getbootstrap.com</a>.
        iOS uygulaması da aynı simge adını kullanır.
    </div>
    <span asp-validation-for="Icon" class="text-danger small"></span>
</div>
