@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Pano";

    var kutular = new[]
    {
        (Baslik: "Kategori", Sayi: Model.CategoryCount, Simge: "bi-tags", Renk: "bg-primary", Controller: "Categories"),
        (Baslik: "Konum", Sayi: Model.LocationCount, Simge: "bi-geo-alt", Renk: "bg-success", Controller: "Locations"),
        (Baslik: "Onay bekleyen ilan", Sayi: Model.PendingItemCount, Simge: "bi-hourglass-split", Renk: "bg-warning", Controller: ""),
        (Baslik: "Kullanıcı", Sayi: Model.UserCount, Simge: "bi-people", Renk: "bg-danger", Controller: "")
    };
}

<h1 class="h3 mb-1">Pano</h1>
<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item active">Yönetim paneli · toplam @Model.ItemCount ilan</li>
</ol>

<div class="row g-3 mb-4">
    @foreach (var kutu in kutular)
    {
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card @kutu.Renk text-white h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fs-2 fw-bold">@kutu.Sayi</div>
                        <div class="small">@kutu.Baslik</div>
                    </div>
                    <i class="bi @kutu.Simge fs-1 opacity-50"></i>
                </div>
                @if (kutu.Controller != "")
                {
                    <a class="card-footer d-flex justify-content-between small text-white stretched-link text-decoration-none"
                       asp-controller="@kutu.Controller" asp-action="Index">
                        Yönet <i class="bi bi-chevron-right"></i>
                    </a>
                }
                else
                {
                    <div class="card-footer small text-white-50">Sonraki haftalarda</div>
                }
            </div>
        </div>
    }
</div>

<div class="card">
    <div class="card-header"><i class="bi bi-info-circle me-1"></i>Bu panelde</div>
    <div class="card-body small">
        <ul class="mb-0">
            <li><strong>Kategoriler</strong> ve <strong>Konumlar</strong>: ekleme, düzenleme, silme. İlana bağlı bir kayıt silinemez.</li>
            <li>Kullanıcı ve rol yönetimi ile istatistik grafikleri 8. haftada eklenecek.</li>
        </ul>
    </div>
</div>
