@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Pano";

    var kutular = new[]
    {
        (Baslik: "Onay bekleyen ilan", Sayi: Model.PendingItemCount, Simge: "bi-hourglass-split", Area: "Gorevli", Controller: "Approvals",
            Eylem: "Kuyruğa git", Dikkat: Model.PendingItemCount > 0),
        (Baslik: "Kategori", Sayi: Model.CategoryCount, Simge: "bi-tags", Area: "Admin", Controller: "Categories", Eylem: "Kategorileri yönet", Dikkat: false),
        (Baslik: "Konum", Sayi: Model.LocationCount, Simge: "bi-geo-alt", Area: "Admin", Controller: "Locations", Eylem: "Konumları yönet", Dikkat: false),
        (Baslik: "Kullanıcı", Sayi: Model.UserCount, Simge: "bi-people", Area: "Admin", Controller: "", Eylem: "Yönetim 8. haftada", Dikkat: false)
    };
}

<h1 class="h3 mb-0">Pano</h1>
<p class="admin-lede">Sistemde toplam <strong class="tabular">@Model.ItemCount</strong> ilan var.</p>

<div class="stat-grid">
    @foreach (var kutu in kutular)
    {
        if (kutu.Controller != "")
        {
            <a class="stat @(kutu.Dikkat ? "is-alert" : "")" asp-area="@kutu.Area" asp-controller="@kutu.Controller" asp-action="Index">
                <span class="stat-head">@kutu.Baslik<i class="bi @kutu.Simge" aria-hidden="true"></i></span>
                <span class="stat-number">@kutu.Sayi</span>
                <span class="stat-foot">@kutu.Eylem<i class="bi bi-arrow-right" aria-hidden="true"></i></span>
            </a>
        }
        else
        {
            <div class="stat">
                <span class="stat-head">@kutu.Baslik<i class="bi @kutu.Simge" aria-hidden="true"></i></span>
                <span class="stat-number">@kutu.Sayi</span>
                <span class="stat-foot">@kutu.Eylem</span>
            </div>
        }
    }
</div>

<section class="surface p-3 p-sm-4" aria-labelledby="paneldeBaslik">
    <h2 id="paneldeBaslik" class="h6 mb-2"><i class="bi bi-info-circle me-1" aria-hidden="true"></i>Bu panelde</h2>
    <ul class="mb-0 small">
        <li><strong>Kategoriler</strong> ve <strong>Konumlar</strong>: ekleme, düzenleme, silme. İlana bağlı bir kayıt silinemez.</li>
        <li>Kullanıcı ve rol yönetimi ile istatistik grafikleri 8. haftada eklenecek.</li>
    </ul>
</section>
