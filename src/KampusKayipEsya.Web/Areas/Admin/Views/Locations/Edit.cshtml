@model LocationFormViewModel
@{
    ViewData["Title"] = "Konumu düzenle";
}

<h1 class="h3 mb-4"><i class="bi bi-pencil me-2"></i>Konumu düzenle</h1>

<div class="card col-12 col-lg-8 col-xl-6">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <partial name="_Form" model="Model" />
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Kaydet</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Vazgeç</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
