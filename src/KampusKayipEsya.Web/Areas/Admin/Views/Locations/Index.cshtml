@model List<LocationListItem>
@{
    ViewData["Title"] = "Konumlar";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1 class="h3 mb-0"><i class="bi bi-geo-alt me-2"></i>Konumlar</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Yeni konum</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Bina</th>
                        <th>Kat / derslik</th>
                        <th class="d-none d-md-table-cell">Koordinat</th>
                        <th class="text-center">İlan sayısı</th>
                        <th class="text-end pe-3">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var konum in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-semibold">@konum.Building</td>
                            <td>@(konum.FloorOrRoom ?? "—")</td>
                            <td class="d-none d-md-table-cell small text-muted">@(konum.Koordinat ?? "—")</td>
                            <td class="text-center">
                                <span class="badge @(konum.ItemCount > 0 ? "text-bg-info" : "text-bg-light")">@konum.ItemCount</span>
                            </td>
                            <td class="text-end pe-3 text-nowrap">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@konum.Id">
                                    <i class="bi bi-pencil"></i><span class="d-none d-sm-inline ms-1">Düzenle</span>
                                </a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@konum.Id">
                                    <i class="bi bi-trash"></i><span class="d-none d-sm-inline ms-1">Sil</span>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">Henüz konum yok.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
