@model LocationListItem
@{
    ViewData["Title"] = "Konumu sil";
}

<h1 class="h3 mb-4"><i class="bi bi-trash me-2"></i>Konumu sil</h1>

<div class="card col-12 col-lg-8 col-xl-6">
    <div class="card-body">
        <dl class="row mb-3">
            <dt class="col-sm-4">Bina</dt>
            <dd class="col-sm-8">@Model.Building</dd>
            <dt class="col-sm-4">Kat / derslik</dt>
            <dd class="col-sm-8">@(Model.FloorOrRoom ?? "—")</dd>
            <dt class="col-sm-4">Koordinat</dt>
            <dd class="col-sm-8">@(Model.Koordinat ?? "—")</dd>
            <dt class="col-sm-4">Bağlı ilan</dt>
            <dd class="col-sm-8">@Model.ItemCount</dd>
        </dl>

        @if (Model.ItemCount > 0)
        {
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle me-1"></i>
                Bu konuma bağlı <strong>@Model.ItemCount</strong> ilan var; ilanlar başka bir konuma taşınmadan silinemez.
            </div>
            <a class="btn btn-outline-secondary" asp-action="Index">Listeye dön</a>
        }
        else
        {
            <p>Bu konumu silmek istediğinize emin misiniz? Bu işlem geri alınamaz.</p>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Evet, sil</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Vazgeç</a>
            </form>
        }
    </div>
</div>
