@model ErrorViewModel
@{
    ViewData["Title"] = "Bir hata oluştu";
    ViewData["NoIndex"] = true;
}

<div class="status-page">
    <span class="status-code">500</span>
    <h1>Bir şeyler ters gitti</h1>
    <p>İsteğin işlenirken beklenmedik bir hata oluştu. Sayfayı yenilemeyi dene; sorun sürerse aşağıdaki kodla kayıp eşya bürosuna haber ver.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small">Hata kodu: <code translate="no">@Model.RequestId</code></p>
    }
    <div class="actions">
        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary">Ana sayfaya dön</a>
    </div>
</div>
