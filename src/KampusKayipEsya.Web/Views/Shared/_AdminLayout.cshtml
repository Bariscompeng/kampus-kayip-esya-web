<!DOCTYPE html>
<html lang="tr" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#18181a" />
    <title>@ViewData["Title"] · Yönetim · Kampüs Kayıp Eşya</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/lib/sb-admin/dist/css/styles.css" />
    @* İkon yazı tipi ilk boyamayı beklemesin: stil sayfası engellemeden yüklenir. *@
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" /></noscript>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="sb-nav-fixed">
    @{
        var area = ViewContext.RouteData.Values["area"]?.ToString();
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
        bool AktifMi(string a, string c) => area == a && controller == c;
        string Aktif(string a, string c) => AktifMi(a, c) ? "active" : "";
        string? Mevcut(string a, string c) => AktifMi(a, c) ? "page" : null;
        var yonetici = User.IsInRole(Roles.Admin);
    }
    <a class="skip-link" href="#panelIcerik">İçeriğe geç</a>

    <nav class="sb-topnav navbar navbar-expand navbar-dark bg-dark" aria-label="Panel üst menüsü">
        <a class="navbar-brand ps-3" asp-area="@(yonetici ? "Admin" : "Gorevli")" asp-controller="Home" asp-action="Index">
            <span class="brand-mark" aria-hidden="true"></span>@(yonetici ? "Yönetim Paneli" : "Görevli Paneli")
        </a>
        <button class="btn btn-link btn-sm order-1 order-lg-0 me-2 me-lg-0 text-white" id="sidebarToggle" type="button"
                aria-label="Yan menüyü aç/kapat" aria-controls="layoutSidenav_nav">
            <i class="bi bi-list fs-5" aria-hidden="true"></i>
        </button>
        <div class="ms-auto me-3 d-flex align-items-center gap-3">
            <a class="link-light text-decoration-none small d-none d-sm-inline-flex" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-box-arrow-up-right me-1" aria-hidden="true"></i>Siteye dön
            </a>
            <span class="small d-none d-md-inline" style="color: var(--on-ink-muted)" translate="no">@User.Identity?.Name</span>
            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                <button type="submit" class="btn btn-outline-light btn-sm">Çıkış</button>
            </form>
        </div>
    </nav>

    <div id="layoutSidenav">
        <div id="layoutSidenav_nav">
            <nav class="sb-sidenav accordion sb-sidenav-dark" aria-label="Panel menüsü">
                <div class="sb-sidenav-menu">
                    <div class="nav">
                        @if (yonetici)
                        {
                            <div class="sb-sidenav-menu-heading">Yönetim</div>
                            <a class="nav-link @Aktif("Admin", "Home")" aria-current="@Mevcut("Admin", "Home")" asp-area="Admin" asp-controller="Home" asp-action="Index">
                                <div class="sb-nav-link-icon"><i class="bi bi-speedometer2" aria-hidden="true"></i></div>
                                Pano
                            </a>
                            <a class="nav-link @Aktif("Admin", "Categories")" aria-current="@Mevcut("Admin", "Categories")" asp-area="Admin" asp-controller="Categories" asp-action="Index">
                                <div class="sb-nav-link-icon"><i class="bi bi-tags" aria-hidden="true"></i></div>
                                Kategoriler
                            </a>
                            <a class="nav-link @Aktif("Admin", "Locations")" aria-current="@Mevcut("Admin", "Locations")" asp-area="Admin" asp-controller="Locations" asp-action="Index">
                                <div class="sb-nav-link-icon"><i class="bi bi-geo-alt" aria-hidden="true"></i></div>
                                Konumlar
                            </a>
                            <span class="nav-link disabled" aria-disabled="true">
                                <div class="sb-nav-link-icon"><i class="bi bi-people" aria-hidden="true"></i></div>
                                Kullanıcılar <span class="soon-label">yakında</span>
                            </span>
                            <span class="nav-link disabled" aria-disabled="true">
                                <div class="sb-nav-link-icon"><i class="bi bi-bar-chart" aria-hidden="true"></i></div>
                                İstatistikler <span class="soon-label">yakında</span>
                            </span>
                        }
                        @if (User.IsInRole(Roles.Gorevli) || yonetici)
                        {
                            <div class="sb-sidenav-menu-heading">Kayıp Eşya Bürosu</div>
                            <a class="nav-link @Aktif("Gorevli", "Approvals")" aria-current="@Mevcut("Gorevli", "Approvals")" asp-area="Gorevli" asp-controller="Approvals" asp-action="Index">
                                <div class="sb-nav-link-icon"><i class="bi bi-clipboard-check" aria-hidden="true"></i></div>
                                Onay kuyruğu
                                @await Component.InvokeAsync("PendingItemCount")
                            </a>
                        }
                    </div>
                </div>
                <div class="sb-sidenav-footer">
                    <div class="small">Giriş yapan</div>
                    @(yonetici ? "Yönetici" : "Görevli")
                </div>
            </nav>
        </div>

        <div id="layoutSidenav_content">
            <main id="panelIcerik" class="container-fluid px-3 px-sm-4 py-4" tabindex="-1">
                <partial name="_IslemMesajlari" />
                @RenderBody()
            </main>
            <footer class="py-3 mt-auto">
                <div class="container-fluid px-4 small text-muted">
                    &copy; 2026 Kampüs Kayıp Eşya · BLM4581 · Şablon: Start Bootstrap SB Admin (MIT)
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/sb-admin/dist/js/scripts.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
