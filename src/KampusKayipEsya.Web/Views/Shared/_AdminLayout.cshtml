<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Yönetim · Kampüs Kayıp Eşya</title>
    <link rel="stylesheet" href="~/lib/sb-admin/dist/css/styles.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="sb-nav-fixed">
    @{
        var area = ViewContext.RouteData.Values["area"]?.ToString();
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
        string Aktif(string a, string c) => area == a && controller == c ? "active" : "";
    }

    <nav class="sb-topnav navbar navbar-expand navbar-dark bg-dark">
        <a class="navbar-brand ps-3" asp-area="Admin" asp-controller="Home" asp-action="Index">
            <i class="bi bi-search-heart me-1"></i>Yönetim Paneli
        </a>
        <button class="btn btn-link btn-sm order-1 order-lg-0 me-4 me-lg-0 text-white" id="sidebarToggle" type="button" aria-label="Yan menüyü aç/kapat">
            <i class="bi bi-list fs-5"></i>
        </button>
        <div class="ms-auto me-3 d-flex align-items-center gap-3">
            <a class="link-light text-decoration-none small d-none d-sm-inline" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-box-arrow-up-right me-1"></i>Siteye dön
            </a>
            <span class="text-white-50 small d-none d-md-inline">@User.Identity?.Name</span>
            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                <button type="submit" class="btn btn-outline-light btn-sm">Çıkış</button>
            </form>
        </div>
    </nav>

    <div id="layoutSidenav">
        <div id="layoutSidenav_nav">
            <nav class="sb-sidenav accordion sb-sidenav-dark" aria-label="Yönetim menüsü">
                <div class="sb-sidenav-menu">
                    <div class="nav">
                        @if (User.IsInRole(Roles.Admin))
                        {
                            <div class="sb-sidenav-menu-heading">Yönetim</div>
                            <a class="nav-link @Aktif("Admin", "Home")" asp-area="Admin" asp-controller="Home" asp-action="Index">
                                <div class="sb-nav-link-icon"><i class="bi bi-speedometer2"></i></div>
                                Pano
                            </a>
                            <a class="nav-link @Aktif("Admin", "Categories")" asp-area="Admin" asp-controller="Categories" asp-action="Index">
                                <div class="sb-nav-link-icon"><i class="bi bi-tags"></i></div>
                                Kategoriler
                            </a>
                            <a class="nav-link @Aktif("Admin", "Locations")" asp-area="Admin" asp-controller="Locations" asp-action="Index">
                                <div class="sb-nav-link-icon"><i class="bi bi-geo-alt"></i></div>
                                Konumlar
                            </a>
                            <a class="nav-link disabled" href="#" aria-disabled="true">
                                <div class="sb-nav-link-icon"><i class="bi bi-people"></i></div>
                                Kullanıcılar
                            </a>
                            <a class="nav-link disabled" href="#" aria-disabled="true">
                                <div class="sb-nav-link-icon"><i class="bi bi-bar-chart"></i></div>
                                İstatistikler
                            </a>
                        }
                        @if (User.IsInRole(Roles.Gorevli) || User.IsInRole(Roles.Admin))
                        {
                            <div class="sb-sidenav-menu-heading">Kayıp Eşya Bürosu</div>
                            <a class="nav-link @Aktif("Gorevli", "Home")" asp-area="Gorevli" asp-controller="Home" asp-action="Index">
                                <div class="sb-nav-link-icon"><i class="bi bi-clipboard-check"></i></div>
                                Görevli Paneli
                            </a>
                        }
                    </div>
                </div>
                <div class="sb-sidenav-footer">
                    <div class="small">Giriş yapan:</div>
                    @(User.IsInRole(Roles.Admin) ? "Admin" : "Görevli")
                </div>
            </nav>
        </div>

        <div id="layoutSidenav_content">
            <main class="container-fluid px-4 py-4">
                @if (TempData["Basari"] is string basari)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle me-1"></i>@basari
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                    </div>
                }
                @if (TempData["Hata"] is string hata)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle me-1"></i>@hata
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                    </div>
                }
                @RenderBody()
            </main>
            <footer class="py-3 bg-light mt-auto">
                <div class="container-fluid px-4 small text-muted">
                    &copy; 2026 Kampüs Kayıp Eşya · BLM4581 · Şablon: Start Bootstrap SB Admin (MIT)
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/sb-admin/dist/js/scripts.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
