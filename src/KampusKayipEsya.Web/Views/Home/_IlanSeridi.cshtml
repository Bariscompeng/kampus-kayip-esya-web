@using KampusKayipEsya.Web.Models.Enums
@using KampusKayipEsya.Web.ViewModels
@model (IReadOnlyList<Item> Ilanlar, ItemType Tur, string Bos)

@if (Model.Ilanlar.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-inbox" aria-hidden="true"></i>
        <span>@Model.Bos</span>
    </div>
}
else
{
    <div class="item-strip">
        @foreach (var ilan in Model.Ilanlar)
        {
            var kapak = ilan.Photos.OrderBy(p => p.Order).FirstOrDefault();
            <a href="/items/@ilan.Id" class="item-row">
                @if (kapak is not null)
                {
                    <img src="@Url.Content("~/" + kapak.Path)" alt="" width="52" height="52" class="item-thumb" loading="lazy" />
                }
                else
                {
                    <span class="item-thumb @(Model.Tur == ItemType.Found ? "is-found" : "is-lost")" aria-hidden="true"><span class="placeholder-tag"><i class="bi @(ilan.Category.Icon ?? "bi-tag")"></i></span></span>
                }
                <span class="item-row-body">
                    <span class="item-row-title d-block">@ilan.Title</span>
                    <span class="item-meta d-block">
                        <i class="bi bi-geo-alt" aria-hidden="true"></i>@ilan.Location.Building · @HomeIndexViewModel.GoreliZaman(ilan.EventDate)
                    </span>
                </span>
                <span class="chip flex-shrink-0 d-none d-sm-inline-flex">@ilan.Category.Name</span>
                <i class="bi bi-arrow-right arrow item-row-arrow" aria-hidden="true"></i>
            </a>
        }
    </div>
    <a class="strip-more" asp-controller="Items" asp-action="Index" asp-route-type="@Model.Tur">
        Tümünü gör<i class="bi bi-arrow-right arrow" aria-hidden="true"></i>
    </a>
}
