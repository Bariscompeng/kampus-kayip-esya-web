@using KampusKayipEsya.Web.Models.Enums
@model KampusKayipEsya.Web.ViewModels.HomeIndexViewModel
@{
    ViewData["Title"] = "Ana Sayfa";
    ViewData["Description"] = "Kampüste kaybolan ve bulunan eşyaların ilan panosu. Kayıp eşyanı ara, bulduğun eşya için ilan aç; eşya sahibine güvenle ulaşsın.";
    var bulunanSeridi = (Model.SonBulunanlar, ItemType.Found, "Henüz yayında bulunan eşya ilanı yok.");
    var kayipSeridi = (Model.SonKayiplar, ItemType.Lost, "Henüz yayında kayıp ilanı yok.");
}

<section class="hero-search" aria-labelledby="anaBaslik">
    <h1 id="anaBaslik">Kampüste bir şey mi kaybettin?</h1>
    <p class="lede">Kayıp ve bulunan eşyalar tek yerde. İlanını aç, eşyan sahibine güvenle ulaşsın.</p>
    <form class="row g-2" method="get" asp-controller="Items" asp-action="Index" role="search">
        <div class="col-12 col-md">
            <label for="anaArama" class="visually-hidden">İlanlarda ara</label>
            <input id="anaArama" type="search" class="form-control form-control-lg" name="q" maxlength="100"
                   placeholder="Ne arıyorsun? (ör. siyah cüzdan)" autocomplete="off" enterkeyhint="search" />
        </div>
        <div class="col-12 col-md-auto d-grid">
            <button class="btn btn-primary btn-lg px-4" type="submit">
                <i class="bi bi-search me-2" aria-hidden="true"></i>Ara
            </button>
        </div>
    </form>
    <div class="hero-actions">
        <a asp-controller="Items" asp-action="Index" asp-route-type="Found"><i class="bi bi-arrow-right arrow" aria-hidden="true"></i>Bulunan eşyalara göz at</a>
        <a asp-controller="Items" asp-action="Create"><i class="bi bi-arrow-right arrow" aria-hidden="true"></i>Bir eşya buldum, ilan açacağım</a>
    </div>
</section>

<section aria-labelledby="kategoriBaslik">
    <h2 id="kategoriBaslik" class="section-title">Kategoriler</h2>
    @if (Model.Categories.Count == 0)
    {
        <div class="empty-state mb-5">
            <i class="bi bi-tags" aria-hidden="true"></i>
            <strong>Henüz kategori eklenmemiş</strong>
            <span>Kategoriler eklendiğinde ilanları buradan türüne göre gezebilirsiniz.</span>
        </div>
    }
    else
    {
        <div class="category-grid">
            @foreach (var kategori in Model.Categories)
            {
                <a class="category-tile" asp-controller="Items" asp-action="Index" asp-route-categoryId="@kategori.Id">
                    <i class="bi @(kategori.Icon ?? "bi-tag")" aria-hidden="true"></i>
                    <span>@kategori.Name</span>
                </a>
            }
        </div>
    }
</section>

<div class="row g-4 g-lg-5">
    <section class="col-12 col-lg-6" aria-labelledby="bulunanBaslik">
        <h2 id="bulunanBaslik" class="section-title"><span class="tag tag-found tag-lg" aria-hidden="true">Bulundu</span>Son bulunan eşyalar</h2>
        <partial name="_IlanSeridi" model="bulunanSeridi" />
    </section>
    <section class="col-12 col-lg-6" aria-labelledby="kayipBaslik">
        <h2 id="kayipBaslik" class="section-title"><span class="tag tag-lost tag-lg" aria-hidden="true">Kayıp</span>Son kayıp ilanları</h2>
        <partial name="_IlanSeridi" model="kayipSeridi" />
    </section>
</div>
