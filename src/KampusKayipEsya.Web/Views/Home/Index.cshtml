@model KampusKayipEsya.Web.ViewModels.HomeIndexViewModel
@{
    ViewData["Title"] = "Ana Sayfa";
    var bulunanSeridi = (Model.SonBulunanlar, "success", "Henüz yayında bulunan eşya ilanı yok.");
    var kayipSeridi = (Model.SonKayiplar, "danger", "Henüz yayında kayıp ilanı yok.");
}

<section class="p-4 p-md-5 mb-4 bg-light rounded-3 border">
    <h1 class="display-6 fw-bold">Kampüste bir şey mi kaybettin?</h1>
    <p class="lead mb-4">
        Kayıp ve bulunan eşyalar tek yerde. İlanını aç, eşyan sahibine güvenle ulaşsın.
    </p>
    <form class="row g-2" onsubmit="return false;">
        <div class="col-12 col-md-9">
            <input class="form-control form-control-lg" placeholder="Ne arıyorsun? (ör. siyah cüzdan)" disabled />
        </div>
        <div class="col-12 col-md-3 d-grid">
            <button class="btn btn-primary btn-lg" type="button" disabled>
                <i class="bi bi-search me-1"></i>Ara
            </button>
        </div>
    </form>
</section>

<h2 class="h4 mb-3">Kategoriler</h2>
@if (Model.Categories.Count == 0)
{
    <div class="alert alert-warning">Henüz kategori yok. <code>dotnet ef database update</code> çalıştırıldı mı?</div>
}
else
{
    <div class="row row-cols-2 row-cols-sm-3 row-cols-lg-4 g-3 mb-5">
        @foreach (var kategori in Model.Categories)
        {
            <div class="col">
                <div class="card h-100 text-center shadow-sm">
                    <div class="card-body">
                        <i class="bi @kategori.Icon fs-2 text-primary"></i>
                        <div class="mt-2 fw-semibold">@kategori.Name</div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="row g-4">
    <div class="col-12 col-lg-6">
        <h2 class="h4 mb-3"><i class="bi bi-check2-circle text-success me-1"></i>Son bulunan eşyalar</h2>
        <partial name="_IlanSeridi" model="bulunanSeridi" />
    </div>
    <div class="col-12 col-lg-6">
        <h2 class="h4 mb-3"><i class="bi bi-question-circle text-danger me-1"></i>Son kayıp ilanları</h2>
        <partial name="_IlanSeridi" model="kayipSeridi" />
    </div>
</div>
