@using System.Globalization
@using KampusKayipEsya.Web.Models.Enums
@model KampusKayipEsya.Web.ViewModels.ItemDetailsViewModel
@{
    var ilan = Model.Item;
    var tr = new CultureInfo("tr-TR");
    ViewData["Title"] = ilan.Title;
    ViewData["Description"] = $"{ilan.Type.ToTurkish()}: {ilan.Title}. {ilan.Location.Building}, {ilan.EventDate.ToString("d MMMM yyyy", tr)}. Kategori: {ilan.Category.Name}.";
    if (ilan.Status != ItemStatus.Published) { ViewData["NoIndex"] = true; }
    var bulundu = ilan.Type == ItemType.Found;
}

<a class="back-link mb-3" asp-action="Index"><i class="bi bi-arrow-left arrow-back" aria-hidden="true"></i>İlanlara dön</a>

<partial name="_IslemMesajlari" />

@if (ilan.Status != ItemStatus.Published)
{
    <div class="alert @(ilan.Status == ItemStatus.Rejected ? "alert-danger" : "alert-warning")">
        <i class="bi @(ilan.Status == ItemStatus.Rejected ? "bi-x-circle" : "bi-hourglass-split")" aria-hidden="true"></i>
        <div>
            Bu ilan şu an <strong>@ilan.Status.ToTurkish().ToLower(tr)</strong>; yalnızca ilan sahibi ve kayıp eşya bürosu görevlileri görebilir.
            @if (ilan.Status == ItemStatus.Rejected && ilan.RejectionReason is not null)
            {
                <div class="mt-2"><strong>Ret sebebi:</strong> @ilan.RejectionReason</div>
                @if (Model.IsOwner)
                {
                    <div class="small mt-1">İlanı düzenleyip kaydederseniz yeniden görevli onayına gönderilir.</div>
                }
            }
        </div>
    </div>
}

<div class="row g-4 g-lg-5">
    <div class="col-12 col-lg-7">
        @if (ilan.Photos.Count > 0)
        {
            <div id="ilanFotograflari" class="carousel slide detail-media" aria-label="İlan fotoğrafları">
                @if (ilan.Photos.Count > 1)
                {
                    <div class="carousel-indicators">
                        @for (var i = 0; i < ilan.Photos.Count; i++)
                        {
                            <button type="button" data-bs-target="#ilanFotograflari" data-bs-slide-to="@i"
                                    class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : null)" aria-label="Fotoğraf @(i + 1)"></button>
                        }
                    </div>
                }
                <div class="carousel-inner">
                    @foreach (var (foto, sira) in ilan.Photos.OrderBy(p => p.Order).Select((f, i) => (f, i)))
                    {
                        <div class="carousel-item @(sira == 0 ? "active" : "")">
                            <img src="@Url.Content("~/" + foto.Path)" class="d-block" width="800" height="450"
                                 alt="@ilan.Title, fotoğraf @(sira + 1) / @ilan.Photos.Count" fetchpriority="@(sira == 0 ? "high" : null)" />
                        </div>
                    }
                </div>
                @if (ilan.Photos.Count > 1)
                {
                    <button class="carousel-control-prev" type="button" data-bs-target="#ilanFotograflari" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Önceki fotoğraf</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#ilanFotograflari" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Sonraki fotoğraf</span>
                    </button>
                }
            </div>
        }
        else
        {
            <div class="detail-media is-empty @(bulundu ? "is-found" : "is-lost")">
                <span class="placeholder-tag" aria-hidden="true"><i class="bi @(ilan.Category.Icon ?? "bi-tag")"></i></span>
                <span class="placeholder-note">Fotoğraf eklenmemiş</span>
            </div>
        }
    </div>

    <div class="col-12 col-lg-5">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <span class="@ilan.Type.TagClass() tag-lg" style="--tag-hole: var(--paper)">@ilan.Type.ToTurkish()</span>
            <span class="@ilan.Status.BadgeClass() status-lg">@ilan.Status.ToTurkish()</span>
        </div>
        <h1 class="detail-title">@ilan.Title</h1>

        <dl class="fact-list">
            <dt><i class="bi @(ilan.Category.Icon ?? "bi-tag")" aria-hidden="true"></i>Kategori</dt>
            <dd>@ilan.Category.Name</dd>
            <dt><i class="bi bi-geo-alt" aria-hidden="true"></i>Konum</dt>
            <dd>@ilan.Location.Building@(ilan.Location.FloorOrRoom is null ? "" : ", " + ilan.Location.FloorOrRoom)</dd>
            <dt><i class="bi bi-calendar-event" aria-hidden="true"></i>@(bulundu ? "Bulunma" : "Kaybolma") tarihi</dt>
            <dd><time datetime="@ilan.EventDate.ToString("yyyy-MM-dd")">@ilan.EventDate.ToString("d MMMM yyyy", tr)</time></dd>
            <dt><i class="bi bi-person" aria-hidden="true"></i>İlanı açan</dt>
            <dd>@Model.OwnerShortName</dd>
            <dt><i class="bi bi-clock" aria-hidden="true"></i>İlan tarihi</dt>
            <dd>@ilan.CreatedAt.ToLocalTime().ToString("d MMMM yyyy HH:mm", tr)</dd>
        </dl>

        <h2 class="h6 text-muted mb-2">Açıklama</h2>
        <p class="detail-desc">@ilan.Description</p>

        @if (Model.CanSeeQuestion && ilan.VerificationQuestion is not null)
        {
            <div class="field-panel mb-3 small">
                <div class="fw-semibold mb-1"><i class="bi bi-shield-lock me-1" aria-hidden="true"></i>Doğrulama sorusu</div>
                @ilan.VerificationQuestion
                <div class="text-muted mt-1">Talepte bulunan kişi bu soruyu cevaplayacak.</div>
            </div>
        }

        <div class="d-grid gap-2">
            @if (Model.IsOwner)
            {
                @if (ilan.Status is not (ItemStatus.Resolved or ItemStatus.Archived))
                {
                    <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@ilan.Id">
                        <i class="bi bi-pencil me-2" aria-hidden="true"></i>Düzenle
                    </a>
                }
                @if (bulundu)
                {
                    <a class="btn btn-outline-primary" href="/gelen-talepler">
                        <i class="bi bi-inbox me-2" aria-hidden="true"></i>Gelen talepler
                        @if (Model.ClaimCount > 0)
                        {
                            <span class="count-pill">@Model.ClaimCount</span>
                        }
                    </a>
                }
                <a class="btn btn-outline-secondary" asp-action="Mine" asp-route-sekme="@KampusKayipEsya.Web.ViewModels.MyItemsViewModel.SekmeOf(ilan.Status)">
                    <i class="bi bi-person-lines-fill me-2" aria-hidden="true"></i>İlanlarım
                </a>
            }
            else if (bulundu && ilan.Status == ItemStatus.Published)
            {
                <section class="claim-panel" aria-labelledby="talepBaslik">
                    @if (Model.MyClaim is { } talebim)
                    {
                        <span class="@talebim.Status.BadgeClass()">@talebim.Status.ToTurkish()</span>
                        <h2 id="talepBaslik" class="h6 mt-2 mb-1">Bu eşya için talebin var</h2>
                        <p class="mb-0 small">
                            <time datetime="@talebim.CreatedAt.ToString("o")">@talebim.CreatedAt.ToLocalTime().ToString("d MMMM yyyy HH:mm", tr)</time> tarihinde gönderdin.
                            İlan sahibi cevabını inceleyip yanıtlayacak.
                        </p>
                    }
                    else
                    {
                        <h2 id="talepBaslik" class="h6 mb-1">Bu eşya senin mi?</h2>
                        <p class="mb-0 small">
                            Doğrulama sorusunu cevaplayarak sahiplenme talebi gönder. Cevabını yalnızca ilanı açan kişi ve görevliler görür;
                            telefon ve e-posta bilgilerin paylaşılmaz.
                        </p>
                    }
                </section>
                @if (Model.MyClaim is not null)
                {
                    <a class="btn btn-outline-primary" href="/taleplerim">
                        <i class="bi bi-send-check me-2" aria-hidden="true"></i>Taleplerim
                    </a>
                }
                else
                {
                    <a class="btn btn-primary btn-lg" href="/items/@ilan.Id/talep">
                        <i class="bi bi-hand-index-thumb me-2" aria-hidden="true"></i>@(User.Identity?.IsAuthenticated == true ? "Bu benim" : "Giriş yap ve talep et")
                    </a>
                }
                <a class="btn btn-outline-secondary" asp-action="Index" asp-route-categoryId="@ilan.CategoryId">
                    Benzer ilanlara bak<i class="bi bi-arrow-right ms-2 arrow" aria-hidden="true"></i>
                </a>
            }
            else if (!bulundu)
            {
                <section class="claim-panel" aria-labelledby="talepBaslik">
                    <span class="tag tag-lg tag-lost" aria-hidden="true">Yakında</span>
                    <h2 id="talepBaslik" class="h6 mt-2 mb-1">Bu eşyayı sen mi buldun?</h2>
                    <p class="mb-0 small">
                        Bulduğunu bildirme bu sayfadan yapılacak; ilan sahibiyle site içinden yazışacaksın.
                        Telefon ve e-posta bilgileri hiçbir zaman paylaşılmaz.
                    </p>
                </section>
                <a class="btn btn-outline-primary" asp-action="Index" asp-route-categoryId="@ilan.CategoryId">
                    Benzer ilanlara bak<i class="bi bi-arrow-right ms-2 arrow" aria-hidden="true"></i>
                </a>
            }
        </div>
    </div>
</div>
