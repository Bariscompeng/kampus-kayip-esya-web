@model KampusKayipEsya.Web.ViewModels.ItemEditViewModel
@{
    ViewData["Title"] = "İlanı Düzenle";
    ViewData["NoIndex"] = true;
    var bosYer = Math.Max(5 - Model.ExistingPhotos.Count, 0);
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-9 col-xl-8">
        <a class="back-link mb-2" asp-action="Mine"><i class="bi bi-arrow-left arrow-back" aria-hidden="true"></i>İlanlarıma dön</a>
        <div class="page-head">
            <h1 class="h3">İlanı düzenle</h1>
        </div>

        @if (Model.OnayaDuser)
        {
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                <div>Bu ilanı kaydettiğinizde yeniden <strong>görevli onayına</strong> gider; onaylanana kadar yalnızca siz görebilirsiniz.</div>
            </div>
        }

        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="form-card">
            <input asp-for="Id" type="hidden" />
            <partial name="_ItemFields" model="Model" />

            <fieldset class="mb-3">
                <legend class="form-label fs-6">Mevcut fotoğraflar</legend>
                @if (Model.ExistingPhotos.Count == 0)
                {
                    <div class="form-text mt-0">Bu ilanda fotoğraf yok.</div>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var foto in Model.ExistingPhotos)
                        {
                            <div class="photo-choice">
                                <img src="@Url.Content("~/" + foto.Path)" alt="Fotoğraf @(foto.Order + 1)" width="110" height="110"
                                     class="@(foto.Order == 0 ? "is-cover" : "")" />
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="RemovePhotoIds" value="@foto.Id" id="sil-@foto.Id"
                                           checked="@Model.RemovePhotoIds.Contains(foto.Id)" />
                                    <label class="form-check-label small" for="sil-@foto.Id">Sil<span class="visually-hidden">: fotoğraf @(foto.Order + 1)</span></label>
                                </div>
                                @if (foto.Order == 0)
                                {
                                    <div class="cover-label">Kapak</div>
                                }
                            </div>
                        }
                    </div>
                    <div class="form-text">Silmek istediklerinizi işaretleyin. Kalan ilk fotoğraf kapak olur.</div>
                }
            </fieldset>

            <div class="mb-4">
                <label asp-for="Photos" class="form-label">Yeni fotoğraf ekle</label>
                <input asp-for="Photos" type="file" class="form-control" multiple accept=".jpg,.jpeg,.png,image/jpeg,image/png" data-sinir="@bosYer" aria-describedby="fotoYardim" />
                <div id="fotoYardim" class="form-text">Bir ilanda toplam en fazla 5 fotoğraf olabilir (şu an @Model.ExistingPhotos.Count). Her biri en fazla 5&nbsp;MB, JPG/PNG.</div>
                <span asp-validation-for="Photos" class="text-danger small"></span>
                <div id="fotoOnizleme" class="photo-preview" aria-live="polite"></div>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary btn-lg flex-grow-1"><i class="bi bi-check-lg me-2" aria-hidden="true"></i>Değişiklikleri kaydet</button>
                <a class="btn btn-outline-secondary btn-lg" href="/items/@Model.Id">Vazgeç</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ItemFormScripts" />
}
