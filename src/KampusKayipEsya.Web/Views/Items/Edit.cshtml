@model KampusKayipEsya.Web.ViewModels.ItemEditViewModel
@{
    ViewData["Title"] = "İlanı Düzenle";
    var bosYer = 5 - Model.ExistingPhotos.Count;
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-9 col-xl-8">
        <h1 class="h3 mb-1"><i class="bi bi-pencil me-2"></i>İlanı Düzenle</h1>
        <p class="text-muted mb-3">
            <a asp-action="Mine"><i class="bi bi-arrow-left me-1"></i>İlanlarıma dön</a>
        </p>

        @if (Model.OnayaDuser)
        {
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle me-1"></i>
                Bu ilanı kaydettiğinizde yeniden <strong>görevli onayına</strong> gider; onaylanana kadar yalnızca siz görebilirsiniz.
            </div>
        }

        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="card shadow-sm">
            <div class="card-body p-4">
                <input asp-for="Id" type="hidden" />
                <partial name="_ItemFields" model="Model" />

                <div class="mb-3">
                    <label class="form-label">Mevcut fotoğraflar</label>
                    @if (Model.ExistingPhotos.Count == 0)
                    {
                        <div class="form-text mt-0">Bu ilanda fotoğraf yok.</div>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-3">
                            @foreach (var foto in Model.ExistingPhotos)
                            {
                                <div class="text-center">
                                    <img src="@Url.Content("~/" + foto.Path)" alt="Fotoğraf @(foto.Order + 1)" width="110" height="110"
                                         class="rounded border object-fit-cover d-block mb-1 @(foto.Order == 0 ? "border-primary border-2" : "")" />
                                    <div class="form-check d-inline-block">
                                        <input class="form-check-input" type="checkbox" name="RemovePhotoIds" value="@foto.Id" id="sil-@foto.Id"
                                               checked="@Model.RemovePhotoIds.Contains(foto.Id)" />
                                        <label class="form-check-label small" for="sil-@foto.Id">Sil</label>
                                    </div>
                                    @if (foto.Order == 0)
                                    {
                                        <div class="small text-primary">Kapak</div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="form-text">Silmek istediklerinizi işaretleyin. Kalan ilk fotoğraf kapak olur.</div>
                    }
                </div>

                <div class="mb-4">
                    <label asp-for="Photos" class="form-label">Yeni fotoğraf ekle</label>
                    <input asp-for="Photos" type="file" class="form-control" multiple accept=".jpg,.jpeg,.png,image/jpeg,image/png" data-sinir="@Math.Max(bosYer, 0)" />
                    <div class="form-text">Bir ilanda toplam en fazla 5 fotoğraf olabilir (şu an @Model.ExistingPhotos.Count). Her biri en fazla 5 MB, JPG/PNG.</div>
                    <span asp-validation-for="Photos" class="text-danger small"></span>
                    <div id="fotoOnizleme" class="d-flex flex-wrap gap-2 mt-2"></div>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary btn-lg flex-grow-1"><i class="bi bi-check-lg me-1"></i>Kaydet</button>
                    <a class="btn btn-outline-secondary btn-lg" href="/items/@Model.Id">Vazgeç</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ItemFormScripts" />
}
