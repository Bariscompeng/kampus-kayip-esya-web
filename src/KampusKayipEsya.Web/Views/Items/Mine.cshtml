@using System.Globalization
@using KampusKayipEsya.Web.Models.Enums
@using KampusKayipEsya.Web.ViewModels
@model MyItemsViewModel
@{
    ViewData["Title"] = "Profilim";
    ViewData["NoIndex"] = true;
    var sekmeler = new[]
    {
        (Anahtar: MyItemsViewModel.Bekleyen, Baslik: "Onay bekleyen", Simge: "bi-hourglass-split", Ilanlar: Model.Bekleyenler,
            Bos: "Onay bekleyen ilanınız yok."),
        (Anahtar: MyItemsViewModel.Yayinda, Baslik: "Yayında", Simge: "bi-broadcast", Ilanlar: Model.Yayindakiler,
            Bos: "Yayında ilanınız yok. İlanlar görevli onayından sonra burada görünür."),
        (Anahtar: MyItemsViewModel.Kapanmis, Baslik: "Kapanmış", Simge: "bi-archive", Ilanlar: Model.Kapananlar,
            Bos: "Kapanmış ilanınız yok. Teslim edilen, arşivlenen ve reddedilen ilanlar burada görünür.")
    };
    var tr = new CultureInfo("tr-TR");
}

<div class="page-head">
    <div>
        <h1 class="h3">Profilim</h1>
        <p class="lede"><span translate="no">@User.Identity?.Name</span> · İlanlarım</p>
    </div>
    <a class="btn btn-outline-primary" asp-action="Create"><i class="bi bi-plus-lg me-2" aria-hidden="true"></i>Yeni ilan</a>
</div>

<partial name="_IslemMesajlari" />

<div class="nav tabs-bar" role="tablist" aria-label="İlan durumları">
    @foreach (var sekme in sekmeler)
    {
        var aktif = sekme.Anahtar == Model.AktifSekme;
        <button class="nav-link @(aktif ? "active" : "")" id="sekme-@sekme.Anahtar" data-bs-toggle="tab" data-sekme="@sekme.Anahtar"
                data-bs-target="#panel-@sekme.Anahtar" type="button" role="tab" aria-controls="panel-@sekme.Anahtar"
                aria-selected="@(aktif ? "true" : "false")" tabindex="@(aktif ? null : "-1")">
            <i class="bi @sekme.Simge d-none d-sm-inline" aria-hidden="true"></i>@sekme.Baslik
            <span class="tab-count">@sekme.Ilanlar.Count</span>
        </button>
    }
</div>

<div class="tab-content">
    @foreach (var sekme in sekmeler)
    {
        <div class="tab-pane fade @(sekme.Anahtar == Model.AktifSekme ? "show active" : "")" id="panel-@sekme.Anahtar"
             role="tabpanel" aria-labelledby="sekme-@sekme.Anahtar" tabindex="0">
            @if (sekme.Ilanlar.Count == 0)
            {
                <div class="empty-state">
                    <i class="bi @sekme.Simge" aria-hidden="true"></i>
                    <span>@sekme.Bos</span>
                    @if (sekme.Anahtar != MyItemsViewModel.Kapanmis)
                    {
                        <a class="btn btn-outline-primary" asp-action="Create">İlan aç</a>
                    }
                </div>
            }
            else
            {
                <ul class="surface list-unstyled mb-0">
                    @foreach (var ilan in sekme.Ilanlar)
                    {
                        var kapak = ilan.Photos.OrderBy(p => p.Order).FirstOrDefault();
                        var degisebilir = ilan.Status is not (ItemStatus.Resolved or ItemStatus.Archived);
                        <li class="my-item">
                            <a href="/items/@ilan.Id" class="flex-shrink-0" tabindex="-1" aria-hidden="true">
                                @if (kapak is not null)
                                {
                                    <img src="@Url.Content("~/" + kapak.Path)" alt="" width="80" height="80" class="my-item-thumb" loading="lazy" />
                                }
                                else
                                {
                                    <span class="my-item-thumb"><i class="bi @(ilan.Category.Icon ?? "bi-image")"></i></span>
                                }
                            </a>
                            <div class="my-item-body">
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <span class="@ilan.Type.TagClass()">@ilan.Type.ToTurkish()</span>
                                    <span class="@ilan.Status.BadgeClass()">@ilan.Status.ToTurkish()</span>
                                    @if (ilan.Photos.Count > 0)
                                    {
                                        <span class="chip"><i class="bi bi-images" aria-hidden="true"></i>@ilan.Photos.Count<span class="visually-hidden"> fotoğraf</span></span>
                                    }
                                </div>
                                <a href="/items/@ilan.Id" class="my-item-title">@ilan.Title</a>
                                <div class="item-meta">
                                    <i class="bi bi-geo-alt" aria-hidden="true"></i>@ilan.Location.Building
                                    · <time datetime="@ilan.EventDate.ToString("yyyy-MM-dd")">@ilan.EventDate.ToString("d MMM yyyy", tr)</time>
                                </div>
                                @if (ilan.Status == ItemStatus.Rejected && ilan.RejectionReason is not null)
                                {
                                    <div class="reject-note"><i class="bi bi-x-circle" aria-hidden="true"></i><span><strong>Ret sebebi:</strong> @ilan.RejectionReason</span></div>
                                }
                            </div>
                            <div class="my-item-actions">
                                @if (degisebilir)
                                {
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@ilan.Id"><i class="bi bi-pencil me-1" aria-hidden="true"></i>Düzenle</a>
                                }
                                @if (ilan.Status == ItemStatus.Published)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#onayPenceresi"
                                            data-baslik="Teslim edildi olarak kapat" data-buton="Evet, teslim edildi" data-renk="btn-success"
                                            data-mesaj="“@ilan.Title” ilanı kapanacak ve aramalarda görünmeyecek. Bu işlem geri alınamaz."
                                            data-adres="@Url.Action("Resolve", new { id = ilan.Id })">
                                        <i class="bi bi-check2-circle me-1" aria-hidden="true"></i>Teslim edildi
                                    </button>
                                }
                                @if (degisebilir)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#onayPenceresi"
                                            data-baslik="İlanı sil" data-buton="Evet, sil" data-renk="btn-danger"
                                            data-mesaj="“@ilan.Title” ilanı ve fotoğrafları kalıcı olarak silinecek."
                                            data-adres="@Url.Action("Delete", new { id = ilan.Id, sekme = sekme.Anahtar })"
                                            aria-label="@ilan.Title ilanını sil">
                                        <i class="bi bi-trash me-1" aria-hidden="true"></i>Sil
                                    </button>
                                }
                                @if (!degisebilir)
                                {
                                    <a class="btn btn-sm btn-outline-secondary" href="/items/@ilan.Id">Görüntüle</a>
                                }
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    }
</div>

<div class="modal fade" id="onayPenceresi" tabindex="-1" aria-labelledby="onayBaslik" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" method="post" id="onayFormu">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="onayBaslik"></h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body" id="onayMesaj"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button>
                <button type="submit" class="btn" id="onayButon"></button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("onayPenceresi").addEventListener("show.bs.modal", olay => {
            const tetik = olay.relatedTarget;
            document.getElementById("onayFormu").action = tetik.dataset.adres;
            document.getElementById("onayBaslik").textContent = tetik.dataset.baslik;
            document.getElementById("onayMesaj").textContent = tetik.dataset.mesaj;
            const buton = document.getElementById("onayButon");
            buton.textContent = tetik.dataset.buton;
            buton.className = "btn " + tetik.dataset.renk;
        });

        // Seçili sekmeyi adres çubuğuna yaz: yenileme ve geri tuşu aynı sekmeye döner.
        document.querySelectorAll("[data-sekme]").forEach(sekme => sekme.addEventListener("shown.bs.tab", () => {
            const adres = new URL(location.href);
            adres.searchParams.set("sekme", sekme.dataset.sekme);
            history.replaceState(null, "", adres);
        }));
    </script>
}
